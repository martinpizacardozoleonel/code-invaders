            <label>DescripciÃ³n del perfil</label>
            <textarea id="profileDescInput" maxlength="200" rows="3" placeholder="CuÃ©ntanos algo sobre ti..." style="width:100%;resize:vertical;font-family:inherit;padding:8px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);"></textarea>
            <div class="btn-row"><span class="hint" id="descCharCount">0/200</span><button class="btn btn-primary btn-sm" id="saveDescBtn">Guardar</button></div>
          </div>
        </div>
      </div>

      <!-- Marcos: visible solo para usuarios logueados -->
      <div class="frames-section" id="bannerSection">
        <h3> Banners de perfil</h3>
        <p class="hint">Equipa un color Bronce / Plata / Platino / Dorado / Oro Puro / Leyenda y sube tu foto encima.</p>
        <div class="setting-item"><div class="btn-row"><button class="btn btn-ghost btn-sm" id="uploadBannerBtn"> Elegir foto del banner</button><button class="btn btn-ghost btn-sm hidden" id="clearBannerImgBtn"> Quitar foto</button></div><input type="file" id="bannerInput" accept="image/*,video/*" class="hidden"></div>
        <div class="frames-grid" id="bannersGrid"></div>
      </div>
      <div class="frames-section" id="framesSection">
        <h3>ðŸ–¼ï¸ Marcos de perfil</h3>
        <p class="hint">Gana EXP y puntos jugando para desbloquear marcos. Â¡Se guardan en tu cuenta!</p>
        <div class="frames-grid" id="framesGrid"></div>
      </div>
      <div class="frames-section" id="nameColorSection">
        <h3>ðŸŽ¨ Color de nombre</h3>
        <p class="hint">Compra colores con EXP (3000+). Se ve en chat y ranked.</p>
        <div class="frames-grid" id="nameColorsGrid"></div>
      </div>
      <div class="frames-section" id="fxsSection">
        <h3>Efectos del nombre</h3>
        <p class="hint">Se combinan con tu letra: ej. Minecraft + Latido. Precios altos, para viciar.</p>
        <div class="frames-grid" id="fxsGrid"></div>
      </div>
      <div class="frames-section" id="fontsSection">
        <h3>Letras del nombre</h3>
        <p class="hint">Compra estilos de letra con puntos. Se ven en chat, ranked y perfil.</p>
        <div class="frames-grid" id="fontsGrid"></div>
      </div>
      <div class="frames-section" id="bubblesSection">
        <h3>ðŸ’¬ Burbujas de chat</h3>
        <p class="hint">ðŸŽ° Exclusivas de Lucky Coders: no se compran, solo se ganan con suerte girando. Al equiparla todos la ven en chat global, privado y multiplayer.</p>
        <div class="frames-grid" id="bubblesGrid"></div>
      </div>
      <div class="frames-section" id="backupSection">
        <h3>ðŸ’¾ Respaldo de la base de datos</h3>
        <p class="hint">Solo para el dueÃ±o del juego. DescargÃ¡ un respaldo con todas las cuentas (y subilo de vuelta si se pierde la base). Necesita la clave de admin.</p>
        <input type="password" id="backupKey" placeholder="Clave de admin" autocomplete="off" style="width:100%;padding:10px;border-radius:8px;border:1px solid #2a3350;background:#0a0e1a;color:#e6ecff">
        <div class="btn-row" style="margin-top:8px">
          <button class="btn btn-ghost btn-sm" id="backupExportBtn">â¬‡ï¸ Descargar respaldo</button>
          <button class="btn btn-ghost btn-sm" id="backupImportBtn">â¬†ï¸ Subir respaldo</button>
          <input type="file" id="backupFile" accept="application/json,.json" hidden>
        </div>
      </div>
      <div class="danger-zone" id="dangerZone">
        <h3>âš ï¸ Zona peligrosa</h3>
        <p class="hint">Borra tu cuenta y desaparecÃ©s del ranked. No se puede deshacer.</p>
        <button class="btn btn-ghost" style="border-color:#ff1744;color:#ff1744" id="deleteAccountBtn">ðŸ—‘ï¸ Borrar mi cuenta</button>
      </div>
      <button class="btn btn-primary" id="settingsCloseBtn">Listo</button>
    </div>
  </div>

  <!-- ============ QUIZ MODO JEFE ============ -->
  <div class="overlay hidden" id="quizOverlay">
    <div class="card card-quiz">
      <div class="quiz-header">
        <div class="quiz-icon" id="quizIcon">â“</div>
        <h2 id="quizTitle">Pregunta sorpresa</h2>
      </div>
      <p class="quiz-question" id="quizQuestion"></p>
      <div class="quiz-options" id="quizOptions"></div>
      <div class="quiz-feedback hidden" id="quizFeedback"></div>
    </div>
  </div>

  <!-- ============ INSPECCIONAR PERFIL ============ -->
  <div class="overlay hidden" id="inspectOverlay">
    <div class="card card-lg inspect-card">
      <h2 class="inspect-title"><span class="inspect-title-icon">ðŸ‘¤</span> PERFIL DE JUGADOR</h2>
      <div class="inspect-content" id="inspectContent"></div>
      <div class="inspect-footer"><button class="btn btn-primary" id="inspectCloseBtn">âœ• Cerrar</button></div>
    </div>
  </div>

  <script src="js/api.js?v=13"></script>
  <script src="js/qr.js?v=1"></script>
  <script src="js/auth.js?v=3"></script>
  <script src="js/notifications.js?v=2"></script>
  <script src="js/docs.js?v=8"></script>
    <script src="js/intro.js?v=4"></script>
    <script src="js/ships.js?v=2"></script>
    <script src="js/lasers.js?v=1"></script>
    <script src="js/impacts.js?v=1"></script>
    <script src="js/game.js?v=32"></script>
  <script src="js/profile.js?v=15"></script>
  <script src="js/ranked.js?v=10"></script>
  <script src="js/chat.js?v=7"></script>
  <script src="js/friends.js?v=9"></script>
    <script src="js/multi.js?v=14"></script>
  <script src="js/report.js?v=1"></script>
  <script src="js/clans.js?v=1"></script>
  <script src="js/app.js?v=10"></script>
  <script>
  const LuckyRoyale={
    spinning:false, items:[], ledsTimer:null,
    colors:{common:'#9aa7b8',rare:'#00e5ff',epic:'#8b5cf6',legendary:'#ffd600',mythic:'#ff1744'},
    init(){ this.buildLeds(); this.draw(); this.loadPool(); },
    iconFor(it){ if(!it) return 'ðŸ’¬'; if(it.type==='coins') return (it.amount>=1000?'ðŸ’°':'ðŸª™'); if(it.type==='exp') return 'âš¡'; return ({'neon_blue':'ðŸ’™','emerald':'ðŸ’š','gold':'ðŸ’›','fire':'ðŸ”¥','galaxy':'ðŸŒŒ','void':'ðŸ•³ï¸','rainbow':'ðŸŒˆ','diamond':'ðŸ’Ž','glitch':'ðŸ‘¾','exclusive_00':'ðŸ‘‘'}[it.bubbleId]||'ðŸ’¬'); },
    labelFor(it){ if(!it) return '?'; if(it.type==='bubble') return (it.bubbleId||'').replace(/_/g,' '); return it.name||'?'; },
    async loadPool(){
      try{
        const r=await fetch('/api/lucky/pool'); const data=await r.json();
        if(data&&data.items&&data.items.length){ this.items=data.items; this.draw(); this.renderOdds(); }
      }catch(e){}
    },
    renderOdds(){
      const box=document.getElementById('luckyOdds'); if(!box||!this.items.length) return;
      const RLN={common:'COMÃšN',rare:'RARO',epic:'Ã‰PICO',legendary:'LEGENDARIO',mythic:'MÃTICO'};
      box.innerHTML='<div class="lucky-odds-title">ðŸŽ LO QUE TE PUEDE TOCAR</div>'+this.items.map(it=>'<div class="lucky-odds-row rw-'+(it.rarity||'common')+'"><span>'+this.iconFor(it)+' '+this.labelFor(it)+'</span><span>â—† '+(RLN[it.rarity]||it.rarity)+' Â· '+(it.chance!=null?it.chance+'%':'?')+'</span></div>').join('');
    },
    landingDeg(idx){
      const n=this.items.length||13, seg=360/n;
      const center=idx*seg+seg/2;
      let base=((-(center))%360+360)%360;
      const jit=(Math.random()*2-1)*seg*0.32;
      const turns=360*(5+Math.floor(Math.random()*3));
      return base+jit+turns;
    },
    buildLeds(){
      const w=document.getElementById('luckyLeds'); if(!w||w.children.length) return;
      for(let i=0;i<16;i++){ const s=document.createElement('i'); const a=(i/16)*Math.PI*2; const R=142;
        s.style.left=(150+Math.cos(a)*R-3.5)+'px'; s.style.top=(150+Math.sin(a)*R-3.5)+'px'; w.appendChild(s); }
      let k=0; clearInterval(this.ledsTimer);
      this.ledsTimer=setInterval(()=>{ k++; [...w.children].forEach((el,j)=>el.classList.toggle('on',(j+k)%2===0)); },this.spinning?120:600);
    },
    blip(f,dur,type){ try{ const C=window.AudioContext||window.webkitAudioContext; if(!C) return; this._ac=this._ac||new C();
      const o=this._ac.createOscillator(),g=this._ac.createGain(); o.type=type||'square'; o.frequency.value=f;
      o.connect(g); g.connect(this._ac.destination); g.gain.value=.04; o.start(); g.gain.exponentialRampToValueAtTime(.0001,this._ac.currentTime+(dur||.08)); o.stop(this._ac.currentTime+(dur||.08)); }catch(e){} },
    draw(pool){
      if(pool&&pool.length) this.items=pool;
      const cv=document.getElementById('luckyCanvas'); if(!cv) return;
      const ctx=cv.getContext('2d'); const items=this.items.length?this.items:[
        {name:'500 pts',rarity:'common'},{name:'1000 pts',rarity:'common'},{name:'1000 EXP',rarity:'common'},
        {bubbleId:'neon_blue',rarity:'rare'},{bubbleId:'emerald',rarity:'rare'},{bubbleId:'gold',rarity:'rare'},
        {bubbleId:'fire',rarity:'epic'},{bubbleId:'galaxy',rarity:'epic'},{bubbleId:'void',rarity:'epic'},
        {bubbleId:'rainbow',rarity:'legendary'},{bubbleId:'diamond',rarity:'legendary'},{bubbleId:'glitch',rarity:'legendary'},{bubbleId:'exclusive_00',rarity:'mythic'}];
      const n=items.length, cx=280, cy=280, R=276, r0=62;
      ctx.clearRect(0,0,560,560); ctx.save(); ctx.translate(cx,cy);
      const seg=Math.PI*2/n;
      const neon={common:['#2a3547','#141c2b'],rare:['#00b0ff','#062a4a'],epic:['#7c4dff','#1e0f4a'],legendary:['#ffb300','#4a2e00'],mythic:['#ff1744','#3d000e']};
      items.forEach((it,i)=>{
        const c=neon[it.rarity]||neon.common;
        const g=ctx.createRadialGradient(0,0,r0,0,0,R); g.addColorStop(0,c[1]); g.addColorStop(1,c[0]);
        ctx.beginPath(); ctx.moveTo(0,0); ctx.arc(0,0,R,i*seg-Math.PI/2,(i+1)*seg-Math.PI/2); ctx.closePath();
        ctx.fillStyle=g; ctx.fill(); ctx.lineWidth=3; ctx.strokeStyle=this.colors[it.rarity]||'#333'; ctx.stroke();
        ctx.save(); ctx.rotate(i*seg+seg/2-Math.PI/2); ctx.textAlign='right'; ctx.fillStyle='#fff';
        ctx.shadowColor=this.colors[it.rarity]||'#fff'; ctx.shadowBlur=10;
        ctx.font='bold 20px monospace';
        let t=it.name||(it.bubbleId||'').replace(/_/g,' ').toUpperCase();
        if(t.length>12) t=t.slice(0,11)+'.';
        ctx.fillText(t,R-18,7);
        ctx.font='18px serif';
        const em=it.type==='coins'?'ðŸ’°':it.type==='exp'?'âš¡':({'neon_blue':'ðŸ’™','emerald':'ðŸ’š','gold':'ðŸ’›','fire':'ðŸ”¥','galaxy':'ðŸŒŒ','void':'ðŸ•³ï¸','rainbow':'ðŸŒˆ','diamond':'ðŸ’Ž','glitch':'ðŸ‘¾','exclusive_00':'ðŸ‘‘'}[it.bubbleId]||'ðŸ’¬');
        ctx.fillText(em,R-18,32);
        ctx.restore();
      });
      ctx.beginPath(); ctx.arc(0,0,R,0,7); ctx.lineWidth=6; ctx.strokeStyle='rgba(0,229,255,.9)'; ctx.stroke();
      ctx.restore();
    },
    spin(count){
      if(this.spinning) return;
      count=[1,5,10].includes(Number(count))?Number(count):1;
      const btns=[...document.querySelectorAll('.spin-btn')];
      const res=document.getElementById('luckyResult');
      if(res) res.classList.add('hidden');
      this.spinning=true;
      btns.forEach(b=>{ b.disabled=true; if(Number(b.dataset.count)===count) b.innerHTML='â—‰ TRANSMITIENDO x'+count+'...'; });
      const hub=document.getElementById('luckyHub'); if(hub) hub.classList.add('spinning');
      const panel=document.getElementById('luckyWheelWrap'); if(panel) panel.classList.remove('shake');
      const wheel=document.getElementById('luckyWheel');
      const inner=document.getElementById('luckyWheelInner');
      const self=this;
      (async()=>{
        let data;
        try{
          const token=(typeof Auth!=='undefined'&&Auth.token)||localStorage.getItem('fx_token')||'';
          const r=await fetch('/api/lucky/spin',{method:'POST',headers:{'Authorization':'Bearer '+token,'Content-Type':'application/json'},body:JSON.stringify({count})});
          data=await r.json();
          if(!r.ok){ Toast.error(data.error||'Error'); self.resetBtn(); return; }
        }catch(e){ Toast.error('Error de red'); self.resetBtn(); return; }
        if(typeof Profile!=='undefined'&&Profile.user){ Profile.user.coins=data.coins; Profile.user.exp=data.exp; Profile.user.chatBubbles=data.chatBubbles; Profile.renderProfile(); if(Profile.loadBubbles) Profile.loadBubbles(); }
        try{ if(typeof Auth!=='undefined'&&Auth.user){ Auth.user.coins=data.coins; Auth.user.exp=data.exp; Auth.user.chatBubbles=data.chatBubbles; if(Auth.saveLocal) Auth.saveLocal(); } }catch(e){}
        if(typeof Game!=='undefined'){ Game.coins=data.coins; }
        const bal=document.getElementById('shopBalance'); if(bal) bal.textContent='ðŸª™ '+data.coins+' puntos';
        const cv=document.getElementById('coinVal'); if(cv) cv.textContent=data.coins;
        if(data.pool&&data.pool.length){ self.items=data.pool; self.draw(); self.renderOdds(); }
        let idx=data.pool?(data.pool.findIndex(x=>x.id===data.winId)):self.items.findIndex(x=>x.id===data.winId);
        if(idx==null||idx<0) idx=Math.floor(Math.random()*(self.items.length||13));
        if(wheel) wheel.classList.remove('lucky-wheel-spinning');
        void (wheel&&wheel.offsetWidth);
        if(inner) inner.style.setProperty('--spin-deg',self.landingDeg(idx)+'deg');
        if(wheel) wheel.classList.add('lucky-wheel-spinning');
        let ticks=0; const tickInt=setInterval(()=>{ self.blip(300+ticks*22,.05); if(++ticks>28) clearInterval(tickInt); },150);
        setTimeout(()=>{
          const items=data.items||[data.item];
          const RLN={common:'COMÃšN',rare:'RARO',epic:'Ã‰PICO',legendary:'LEGENDARIO',mythic:'MÃTICO'};
          const best=data.winId?(items.find(i=>i.id===data.winId)||items[0]):(items.find(i=>i.rarity==='mythic')||items.find(i=>i.rarity==='legendary')||items[0]);
          [880,660,990,1320].forEach((f,i)=>setTimeout(()=>self.blip(f,.12,i>1?'sawtooth':'square'),i*110));
          if(panel){ panel.classList.add('shake'); setTimeout(()=>panel.classList.remove('shake'),500); }
          if(res){
            const rows=items.map(it=>{ const nm=(it.name||it.bubbleId||'?').replace(/_/g,' '); return '<div class="rw-row rw-'+(it.rarity||'common')+'">ðŸŽ° '+nm+' <span>â—† '+(RLN[it.rarity]||it.rarity)+' â—†</span></div>'; }).join('');
            res.className='galaga-result '+(best.rarity||'common');
            res.innerHTML='ðŸŽ¯ LA FLECHA CAYÃ“ EN: <b>'+self.iconFor(best)+' '+self.labelFor(best)+'</b><div class="rw-list">'+rows+'</div><div class="rw-where">ðŸª™/âš¡ sumados al perfil Â· ðŸ’¬ en Ajustes â†’ Burbujas de chat</div>';
            res.classList.remove('hidden');
          }
          Toast.success('ðŸŽ° Ganaste x'+items.length+': '+items.map(i=>(i.name||i.bubbleId||'?').replace(/_/g,' ')).join(', '));
          self.resetBtn();
        },5400);
      })();
    },
    resetBtn(){ this.spinning=false; const hub=document.getElementById('luckyHub'); if(hub) hub.classList.remove('spinning');
      document.querySelectorAll('.spin-btn').forEach(b=>{ b.disabled=false; const c=b.dataset.count;
        if(c==='1') b.innerHTML='â–¶ 1 GIRO â€” 1.000 PTS';
        if(c==='5') b.innerHTML='â˜… 5 GIROS â€” 3.000 PTS';
        if(c==='10') b.innerHTML='ðŸ‘‘ 10 GIROS â€” 5.000 PTS'; }); }
  };
  document.addEventListener('DOMContentLoaded',()=>{ try{ LuckyRoyale.init(); }catch(e){} });
  </script>
</body>
</html>
